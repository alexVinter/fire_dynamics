# PostgreSQL (используются в db и backend)
POSTGRES_USER=django
POSTGRES_PASSWORD=django
POSTGRES_DB=django_db

# Django
DJANGO_SECRET_KEY=your-secret-key-here

# Опционально: отключить debug в продакшене
# DJANGO_DEBUG=0

# На сервере: URL бэкенда для фронта (браузер должен достучаться до API)
# VITE_API_URL=http://IP_СЕРВЕРА:8000

# На сервере: разрешённые CORS-origins (адрес, с которого открывают фронт)
# CORS_ALLOWED_ORIGINS=http://IP_СЕРВЕРА:5173
